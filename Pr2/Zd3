using System;
namespace ConsoleApplication1
{
    class
    Program
    {
        static void Main()
        {

            Console.WriteLine("Введите число n:");
            int n = int.Parse(Console.ReadLine());
            int[,] mas = new int[n, n];
            for (int i = 0; i < n; i++)
            {
                for(int j = 0; j < n; j++)
                {
                    mas[i, j] = 1;
                    if ((i>j & i+j >= n) || (i < j & i + j < n-1)) mas[i,j] = 0;
                    Console.Write(mas[i, j] + " ");
                }
                Console.WriteLine();
            }

        }
    }
}
