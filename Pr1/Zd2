using System;
namespace ConsoleApplication1
{
    class
    Program
    {
        static void Main()
        {
            Console.WriteLine("Введите A: ");
            int a;
            a = Convert.ToInt32(Console.ReadLine());
            double p = a * 0.25;
            Console.WriteLine("Кол-во пищевой соли = " + p);
            p = a * 0.15;
            Console.WriteLine("Кол-во лимонной кислоты = " + p);
            p = a * 0.6;
            Console.WriteLine("Кол-во муки = " + p);
        }
    }

}
