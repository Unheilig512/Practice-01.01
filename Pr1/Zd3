using System;
namespace ConsoleApplication1
{
    class
    Program
    {
        static void Main()
        {
            Console.WriteLine("Введите x: ");
            double x = Convert.ToDouble(Console.ReadLine());
            double y;
            if (x > 3) { y = -3 * x + 9; }
            else y = (Math.Pow(x,3) / x*x + 8);

            Console.WriteLine("Результат = " + y);
        }
    }

}
